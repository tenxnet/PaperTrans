From: PaperTrans maintainers <security@papertrans.invalid>
Subject: [PATCH] pin patched BabelDOC/PyMuPDF and mark the PaperTrans fork

Applies only to upstream commit f8dffcf4c3a33b254391d43514439b975ce8d966.
It removes the unsafe/unsatisfiable dependency combination that could resolve
to BabelDOC 0.6.2, then assigns a distinct PEP 440 local fork version.

diff --git a/pdf2zh_next/__init__.py b/pdf2zh_next/__init__.py
index 1b7def1..34c99ef 100644
--- a/pdf2zh_next/__init__.py
+++ b/pdf2zh_next/__init__.py
@@ -30,7 +30,7 @@ from pdf2zh_next.high_level import do_translate_file_async
 
 # from pdf2zh_next.high_level import translate, translate_stream
 
-__version__ = "2.9.0"
+__version__ = "2.9.0+papertrans.1"
 __author__ = "Byaidu, awwaawwa"
 __license__ = "AGPL-3.0"
 __maintainer__ = "awwaawwa"
diff --git a/pdf2zh_next/const.py b/pdf2zh_next/const.py
index 6dfaa49..8888a47 100644
--- a/pdf2zh_next/const.py
+++ b/pdf2zh_next/const.py
@@ -1,4 +1,4 @@
-__version__ = "2.9.0"
+__version__ = "2.9.0+papertrans.1"
 __major_version__ = "2"
 __config_file_version__ = "3"
 
diff --git a/pdf2zh_next/main.py b/pdf2zh_next/main.py
index 5fc2e81..c979e98 100644
--- a/pdf2zh_next/main.py
+++ b/pdf2zh_next/main.py
@@ -16,7 +16,7 @@ import babeldoc.assets.assets
 from pdf2zh_next.config import ConfigManager
 from pdf2zh_next.high_level import do_translate_file_async
 
-__version__ = "2.9.0"
+__version__ = "2.9.0+papertrans.1"
 
 logger = logging.getLogger(__name__)
 
diff --git a/pyproject.toml b/pyproject.toml
index a20cbc1..749200e 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,6 +1,6 @@
 [project]
 name = "pdf2zh-next"
-version = "2.9.0"
+version = "2.9.0+papertrans.1"
 description = "PDF Translator based on BabelDOC"
 authors = [
     { name = "awwaawwa", email = "aw@funstory.ai" },
@@ -18,7 +18,7 @@ classifiers = [
 dependencies = [
     "requests",
     # for arm64 linux whells
-    "pymupdf<1.25.3",
+    "pymupdf==1.26.7",
     "tqdm",
     "tenacity",
     "numpy",
@@ -33,7 +33,7 @@ dependencies = [
     "gradio-pdf>=0.0.21",
     "peewee>=3.17.8",
     "fontTools",
-    "babeldoc>=0.6.2,<0.7.0",
+    "babeldoc==0.6.4",
     "rich",
     "pydantic-settings>=2.8.1",
     "pydantic>=2.10.6",
@@ -82,7 +82,7 @@ max-line-length = 88
 
 
 [bumpver]
-current_version = "2.9.0"
+current_version = "2.9.0+papertrans.1"
 version_pattern = "MAJOR.MINOR.PATCH[.PYTAGNUM]"
 
 [bumpver.file_patterns]
