#!/bin/sh

set -eu

fail() {
  printf '%s\n' "PaperTrans: $1" >&2
  exit 10
}

platform=$(uname -s 2>/dev/null || true)
case "$platform" in
  Darwin | Linux)
    ;;
  *)
    fail "this launcher supports macOS and Linux only (detected: ${platform:-unknown})"
    ;;
esac

if [ "$(id -u 2>/dev/null || printf '0')" -eq 0 ]; then
  fail "do not run PaperTrans as root or with sudo"
fi

uv_executable=$(command -v uv 2>/dev/null || true)
[ -n "$uv_executable" ] || fail "uv is required; install it from https://docs.astral.sh/uv/"
command -v node >/dev/null 2>&1 || fail "Node.js 22 or newer is required"

node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)
case "$node_major" in
  '' | *[!0-9]*)
    fail "could not determine the installed Node.js version"
    ;;
esac
if [ "$node_major" -lt 22 ]; then
  fail "Node.js 22 or newer is required (detected: $node_major)"
fi

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
cd -- "$launcher_dir"

for required_file in pyproject.toml uv.lock package.json pnpm-lock.yaml docling-models.lock.json; do
  if [ ! -f "$required_file" ] || [ -L "$required_file" ]; then
    fail "required lock/config file is missing or unsafe: $required_file"
  fi
done
if [ -L .venv ]; then
  fail "refusing to use a symlinked .venv"
fi

uv_offline=
for argument do
  if [ "$argument" = "--offline" ]; then
    uv_offline=1
    break
  fi
done

if [ -n "$uv_offline" ]; then
  exec "$uv_executable" run --offline --frozen --extra mcp --group docling \
    python -m papertrans.local_app "$@"
fi

exec "$uv_executable" run --frozen --extra mcp --group docling \
  python -m papertrans.local_app "$@"
