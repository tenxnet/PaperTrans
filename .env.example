# Optional PaperTrans paths. Relative defaults are resolved from the repository root.
PAPERTRANS_REPO_ROOT=
PAPERTRANS_DATA_ROOT=
PAPERTRANS_OUTPUT_ROOT=
PAPERTRANS_DOCLING_ARTIFACTS_PATH=

# The one-command launcher sets these automatically. Set PAPERTRANS_CLI only
# when starting the Web app manually with a non-default virtual environment.
PAPERTRANS_CLI=

# Supported local MCP translation server. Keep the service bound to loopback.
PAPERTRANS_MCP_HOST=127.0.0.1
PAPERTRANS_MCP_PORT=8000
PAPERTRANS_MCP_TRANSPORT=streamable-http

# Optional only when using ChatGPT through OpenAI Secure MCP Tunnel.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=

# Optional override for the experimental PDF/Codex pipeline.
PAPERTRANS_CODEX_BIN=codex
