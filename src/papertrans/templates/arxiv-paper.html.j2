<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  {% if document.validation %}<link rel="stylesheet" href="assets/arxiv-paper.css">{% endif %}
  <title>{{ title }} - PaperTrans</title>
  <style>
    :root{color-scheme:light;--ptx-bg:#f2f0eb;--ptx-paper:#fffefb;--ptx-ink:#20242b;--ptx-muted:#68707b;--ptx-line:#d9dce0;--ptx-blue:#2457a6;--ptx-soft:#f5f7fa;--ptx-warn:#8b5a00}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:74px;max-width:100%;overflow-x:clip}body{margin:0;max-width:100%;overflow-x:clip;background:var(--ptx-bg);color:var(--ptx-ink);font-family:"Hiragino Sans","Noto Sans JP",sans-serif;line-height:1.8}
    .ptx-topbar{position:sticky;top:0;z-index:30;min-height:58px;padding:10px 24px;border-bottom:1px solid var(--ptx-line);background:rgba(255,254,251,.97);display:flex;align-items:center;justify-content:space-between;gap:20px;backdrop-filter:blur(10px)}
    .ptx-brand{font:600 17px Georgia,"Yu Mincho",serif}.ptx-topbar nav{display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:12px}.ptx-topbar a{color:var(--ptx-blue);text-decoration:none}.ptx-status{border:1px solid var(--ptx-line);border-radius:999px;padding:2px 9px;color:var(--ptx-muted)}
    .ptx-shell{width:100%;max-width:1460px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,270px);gap:34px;padding:30px 28px 90px;align-items:start}.ptx-main{width:100%;min-width:0;background:var(--ptx-paper);border:1px solid #e3e0da;padding:50px 68px 82px}
    .ptx-meta{margin:0 0 28px;padding:0 0 20px;border-bottom:1px solid var(--ptx-line);color:var(--ptx-muted);font-size:12px}.ptx-meta strong{color:var(--ptx-ink)}
    .ptx-main .ltx_document{width:100%;max-width:none!important;min-width:0;margin:0!important;padding:0!important;background:transparent!important}.ptx-main .ltx_document section,.ptx-main .ltx_para,.ptx-main .ptx-block,.ptx-main .ptx-ja,.ptx-main details{max-width:100%;min-width:0}.ptx-main .ltx_title_document{font-family:"Yu Mincho","Hiragino Mincho ProN",Georgia,serif;font-size:34px;line-height:1.45;text-align:left;margin:0 0 22px}.ptx-main .ltx_authors{max-width:100%;text-align:left;margin-bottom:34px;color:#3d5f8f}
    .ptx-heading-ja{display:block;font-family:"Yu Mincho","Hiragino Mincho ProN",serif}.ptx-heading-original{display:block;margin-top:4px;color:var(--ptx-muted);font:12px/1.45 Georgia,serif;text-transform:none}.ltx_title_section,.ltx_title_subsection,.ltx_title_subsubsection{scroll-margin-top:76px}
    .ptx-block{margin:0 0 25px}.ptx-ja{overflow-wrap:anywhere;font-family:"Yu Mincho","Hiragino Mincho ProN",serif;font-size:16.5px;line-height:2.04}.ptx-ja math{font-family:math}.ptx-ja .ltx_cite{white-space:normal}.ptx-ja .ltx_cite>.ltx_ref{white-space:nowrap}.ptx-main .ltx_url{white-space:normal!important;overflow-wrap:anywhere;word-break:break-word}.ptx-ja a{color:var(--ptx-blue);text-decoration:none}.ptx-ja a:hover{text-decoration:underline}.ptx-main math[display="block"],.ptx-main .ltx_equation,.ptx-main .ltx_equationgroup,.ptx-main .ltx_eqn_table{max-width:100%;overflow-x:auto;overflow-y:hidden}
    details.ptx-original{margin-top:8px;background:var(--ptx-soft);border-left:2px solid var(--ptx-blue);padding:7px 12px}details.ptx-original summary{cursor:pointer;color:var(--ptx-blue);font-size:12px;font-weight:600}.ptx-original-body{margin-top:7px;color:#424a56;font:13px/1.65 Georgia,serif}.ptx-original-body .ltx_p{margin:0}.ptx-warning{margin-top:6px;color:var(--ptx-warn);font-size:11px}
    .ptx-main figure{width:100%;max-width:100%;margin:36px 0}.ptx-main figure img,.ptx-main figure object,.ptx-main figure svg{display:block;max-width:100%;height:auto;margin-inline:auto}.ptx-main .ltx_table,.ptx-main .ltx_figure_panel:has(table){max-width:100%;overflow-x:auto;overflow-y:hidden;font-size:12px}.ptx-main .ltx_table table{max-width:none}.ptx-main .ltx_flex_figure{max-width:100%;flex-wrap:wrap}.ptx-main .ltx_transformed_outer{max-width:100%}.ptx-main figcaption{max-width:100%;font:13px/1.6 Georgia,serif;color:#444b55}.ptx-main .ltx_bibliography{border-top:1px solid var(--ptx-line);margin-top:48px;padding-top:28px}.ptx-main .ltx_bibitem{overflow-wrap:anywhere;font:12.5px/1.55 Georgia,serif;margin-bottom:9px}
    .ptx-toc{position:sticky;top:82px;max-height:calc(100vh - 110px);overflow:auto;font-size:12px;padding:8px 4px}.ptx-toc h2{font:600 13px/1.4 sans-serif;margin:0 0 12px}.ptx-toc ol{list-style:none;margin:0;padding:0}.ptx-toc li{margin:0 0 7px}.ptx-toc li.level-3{padding-left:12px}.ptx-toc li.level-4{padding-left:24px}.ptx-toc a{color:#4e5764;text-decoration:none}.ptx-toc a:hover{color:var(--ptx-blue)}
    @media(max-width:1200px){.ptx-shell{display:block;padding:20px}.ptx-toc{display:none}.ptx-main{padding:42px 46px 70px}}@media(max-width:720px){.ptx-topbar{position:static;align-items:flex-start;flex-direction:column;padding:10px 14px}.ptx-topbar nav{gap:8px 12px}.ptx-shell{padding:0}.ptx-main{border-inline:0;padding:30px 20px 58px}.ptx-main .ltx_title_document{font-size:28px}.ptx-main .ltx_flex_figure{flex-direction:column}.ptx-main .ltx_flex_cell{width:100%;max-width:100%}.ptx-ja{font-size:16px;line-height:1.95}}@media print{.ptx-topbar,.ptx-toc,details.ptx-original{display:none}.ptx-shell{display:block;padding:0}.ptx-main{border:0;padding:0}body{background:white}}
  </style>
</head>
<body>
  <header class="ptx-topbar">
    <span class="ptx-brand">PaperTrans</span>
    <nav>
      <span class="ptx-status">{% if document.status == "translated" %}翻訳完了{% elif document.status == "needs_review" %}翻訳完了・要確認{% else %}{{ document.status }}{% endif %}</span>
      <span>{{ document.model.translation or "未翻訳" }}</span>
      <a href="{{ document.source.url }}">arXiv HTML</a>
      <a href="https://arxiv.org/pdf/{{ document.source.resolvedArxivId }}">原文PDF</a>
      <a href="document.json">構造JSON</a>
      <a href="qa.json">QA</a>
    </nav>
  </header>
  <div class="ptx-shell">
    <main class="ptx-main">
      <p class="ptx-meta"><strong>{{ document.source.resolvedArxivId }}</strong> · {{ document.source.license or "arXiv source" }} · 公式HTMLから構造を保持して翻訳</p>
      {{ article }}
    </main>
    <aside class="ptx-toc">
      <h2>目次</h2>
      <ol>{% for item in toc %}<li class="level-{{ item.level }}"><a href="#{{ item.anchor }}">{{ item.title }}</a></li>{% endfor %}</ol>
    </aside>
  </div>
</body>
</html>
