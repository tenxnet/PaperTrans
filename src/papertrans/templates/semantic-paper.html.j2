<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="data:,">
  <title>{{ document.title.japanese or document.title.original }} - PaperTrans</title>
  <style>
    :root{color-scheme:light;--bg:#f3f1ec;--paper:#fffefb;--ink:#20242b;--muted:#68707b;--line:#dcdedc;--blue:#2457a6;--soft:#f5f7fa;--warn:#8b5a00}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:78px}body{margin:0;background:var(--bg);color:var(--ink);font-family:"Hiragino Sans","Noto Sans JP",sans-serif;line-height:1.8}
    .topbar{position:sticky;top:0;z-index:10;height:58px;padding:0 24px;border-bottom:1px solid var(--line);background:rgba(255,254,251,.96);display:flex;align-items:center;justify-content:space-between;backdrop-filter:blur(10px)}
    .brand{font:600 17px Georgia,"Yu Mincho",serif}.topbar nav{display:flex;gap:16px;align-items:center;font-size:12px}.topbar a{color:var(--blue);text-decoration:none}.status{border:1px solid var(--line);border-radius:999px;padding:2px 9px;color:var(--muted)}
    .shell{max-width:1360px;margin:auto;display:grid;grid-template-columns:minmax(0,900px) 260px;gap:44px;padding:36px 30px 90px;align-items:start}main{background:var(--paper);border:1px solid #e4e1da;padding:58px 72px 80px;min-width:0}
    .paper-head{padding-bottom:38px;border-bottom:1px solid var(--line)}.eyebrow{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}h1,h2,h3,h4{font-family:"Yu Mincho","Hiragino Mincho ProN",Georgia,serif;font-weight:600;line-height:1.48}h1{font-size:34px;margin:12px 0 8px}.source-title{font:14px/1.55 Georgia,serif;color:var(--muted);margin:0 0 18px}.authors{color:#365d99;margin:0}.affiliations,.metadata{font-size:13px;color:var(--muted);margin:4px 0 0}
    .paper-section{padding-top:36px}.paper-section.level-1{margin-top:16px;border-top:1px solid var(--line)}.paper-section.level-1:first-of-type{border-top:0}.section-heading{margin:0 0 22px}.level-1>.section-heading{font-size:25px}.level-2>.section-heading{font-size:21px}.level-3>.section-heading{font-size:18px}.section-number{color:var(--muted);margin-right:.45em}.heading-source{font:12px/1.5 Georgia,serif;color:var(--muted);margin:-16px 0 22px}
    .paragraph{margin:0 0 27px}.paper-head,.section-heading,.translated,.reference,details.original p,figcaption,.object-meta{overflow-wrap:anywhere;word-break:break-word}.translated{font-family:"Yu Mincho","Hiragino Mincho ProN",serif;font-size:16.5px;line-height:2.06;margin:0}.paragraph.verbatim .translated{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;white-space:pre-wrap}.untranslated{border-left:3px solid #c99532;padding-left:14px;color:var(--warn)}.list_item{padding-left:1.25em;position:relative}.list_item:before{content:"•";position:absolute;left:0;color:var(--blue)}.footnote{font-size:13px;border-left:2px solid var(--line);padding-left:13px;color:#4f5660}
    details.original{margin:8px 0 0;background:var(--soft);border-left:2px solid var(--blue);padding:7px 12px}details.original summary{cursor:pointer;color:var(--blue);font-size:12px;font-weight:600}details.original p{font:13px/1.65 Georgia,serif;color:#424a56;margin:8px 0 2px}.terms{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.term{background:#edf3ff;color:#285397;padding:1px 6px;border-radius:3px;font-size:10px}.warnings{color:var(--warn);font-size:11px;margin-top:6px}
    figure{margin:34px 0 38px;padding:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);scroll-margin-top:76px}figure img{display:block;width:100%;height:auto;background:white}figure.equation{border:0;padding:8px 0}figure.equation img{width:auto;max-width:88%;margin:auto}figure.algorithm img{width:auto;max-width:100%;margin:auto}figcaption{font:13px/1.55 Georgia,serif;color:#444b55;margin-top:12px}.object-meta{font-size:10px;color:var(--muted);margin-top:7px}
    .reference{font:13px/1.55 Georgia,serif;color:#414852;margin:0 0 10px;padding-left:2.8em;text-indent:-2.8em;scroll-margin-top:76px}.citation a,.xref{color:var(--blue);text-decoration:none}.citation a:hover,.xref:hover{text-decoration:underline}
    aside{position:sticky;top:82px;max-height:calc(100vh - 110px);overflow:auto;font-size:12px}aside h2{font:600 13px/1.4 sans-serif;margin:0 0 12px}aside ol{list-style:none;margin:0;padding:0}aside li{margin:0 0 7px}aside li.level-2{padding-left:12px}aside li.level-3{padding-left:24px}aside a{color:#4e5764;text-decoration:none}aside a:hover{color:var(--blue)}
    @media(max-width:980px){.shell{display:block;padding:16px}.shell aside{display:none}main{padding:36px 28px}h1{font-size:28px}}@media print{.topbar,aside,details.original{display:none}.shell{display:block;padding:0}main{border:0;padding:0}body{background:white}}
  </style>
</head>
<body>
  <header class="topbar"><span class="brand">PaperTrans</span><nav><span class="status">{% if document.status == "needs_review" %}翻訳完了・要確認{% elif document.status == "translated" %}翻訳完了{% else %}{{ document.status }}{% endif %}</span><span>翻訳: {{ document.model.translation or "未実行" }}</span><a href="source.pdf">原文PDF</a><a href="semantic-document.json">構造JSON</a></nav></header>
  <div class="shell">
    <main>
      <header class="paper-head">
        <div class="eyebrow">Japanese academic translation{% if document.partial %} preview · {{ document.pageCount }} of {{ document.sourcePageCount }} pages{% else %} · {{ document.pageCount }} pages{% endif %}</div>
        <h1>{{ document.title.japanese or document.title.original }}</h1>
        {% if document.title.japanese %}<p class="source-title">{{ document.title.original }}</p>{% endif %}
        {% if document.frontMatter.authors %}<p class="authors">{% for author in document.frontMatter.authors %}{{ author.original|academic_links }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
        {% if document.frontMatter.affiliations %}<p class="affiliations">{% for value in document.frontMatter.affiliations %}{{ value.original|academic_links }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
        {% if document.frontMatter.metadata %}<p class="metadata">{% for value in document.frontMatter.metadata %}{{ value.original|academic_links }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
      </header>
      {% for section in document.sections %}
      <section class="paper-section level-{{ section.level }}{% if section.syntheticUnheaded %} unheaded{% endif %}" id="{{ section.id }}">
        {% if not section.syntheticUnheaded %}
        <h{{ [section.level + 1, 4]|min }} class="section-heading">{% if section.number %}<span class="section-number">{{ section.number }}</span>{% endif %}{{ section.title.japanese or section.title.original }}</h{{ [section.level + 1, 4]|min }}>
        {% if section.title.japanese %}<p class="heading-source">{{ section.title.original }}</p>{% endif %}
        {% endif %}
        {% for item in section.content %}{% set value = item.value %}
          {% if item.type == "visual" %}
          <figure class="{{ value.kind }}" id="visual-{{ value.objectId }}">
            <img src="{{ value.asset }}" alt="Original {{ value.label or value.kind }} from page {{ value.pageNumber }}">
            {% if value.caption %}<figcaption>{{ value.caption|academic_links }}</figcaption>{% endif %}
            <div class="object-meta">原文 {{ value.pageNumber }}ページ · {{ value.label or value.objectId }}</div>
          </figure>
          {% elif value.kind == "reference" %}
          <p class="reference" id="ref-{{ value.referenceLabel or value.id }}">{{ value.original|academic_links }}</p>
          {% else %}
          <article class="paragraph {{ value.kind }}" id="{{ value.id }}">
            <p class="translated{% if not value.japanese %} untranslated{% endif %}">{{ (value.japanese or value.original)|academic_links }}</p>
            {% if value.preservedTerms %}<div class="terms">{% for term in value.preservedTerms %}<span class="term">{{ term|academic_links }}</span>{% endfor %}</div>{% endif %}
            {% if value.warnings %}<details class="warnings"><summary>確認事項 {{ value.warnings|length }}件</summary>{{ value.warnings|join(" / ") }}</details>{% endif %}
            {% if value.japanese %}<details class="original"><summary>原文を表示{% if value.pages %}（p.{{ value.pages|join(", ") }}）{% endif %}</summary><p>{{ value.original|academic_links }}</p></details>{% endif %}
          </article>
          {% endif %}
        {% endfor %}
      </section>
      {% endfor %}
    </main>
    <aside><h2>目次</h2><ol>{% for section in document.sections %}{% if not section.syntheticUnheaded %}<li class="level-{{ section.level }}"><a href="#{{ section.id }}">{% if section.number %}{{ section.number }} {% endif %}{{ section.title.japanese or section.title.original }}</a></li>{% endif %}{% endfor %}</ol></aside>
  </div>
</body>
</html>
